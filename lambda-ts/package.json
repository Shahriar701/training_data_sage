{
  "name": "lambda-ts",
  "version": "1.0.0",
  "description": "TypeScript Lambda functions for ML Training Infrastructure",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build:audio": "esbuild src/controllers/audio/index.ts --bundle --platform=node --target=node18 --outfile=dist/audio.js",
    "build:upload": "esbuild src/controllers/upload/index.ts --bundle --platform=node --target=node18 --outfile=dist/upload.js",
    "build:download": "esbuild src/controllers/download/index.ts --bundle --platform=node --target=node18 --outfile=dist/download.js",
    "build:training": "esbuild src/controllers/training/index.ts --bundle --platform=node --target=node18 --outfile=dist/training.js",
    "build:all": "npm run clean && npm run build:audio && npm run build:upload && npm run build:download && npm run build:training",
    "test": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.125",
    "@types/node": "^20.8.6",
    "esbuild": "^0.19.5",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.441.0",
    "@aws-sdk/client-ecr": "^3.445.0",
    "@aws-sdk/client-s3": "^3.441.0",
    "@aws-sdk/client-sagemaker": "^3.445.0",
    "@aws-sdk/s3-request-presigner": "^3.441.0",
    "aws-lambda": "^1.0.7",
    "module-alias": "^2.2.3"
  },
  "_moduleAliases": {
    "@domain": "dist/domain",
    "@usecases": "dist/usecases",
    "@controllers": "dist/controllers",
    "@infrastructure": "dist/infrastructure",
    "@utils": "dist/utils"
  }
}
